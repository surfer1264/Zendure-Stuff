let bannerLines = [];
let enabledCount = 0;
 
for (let i = 0; i < CONFIG.devices.length; i++) {
  if (CONFIG.devices[i].enabled) enabledCount++;
}
 
bannerLines[bannerLines.length] = "--------------------------------";
bannerLines[bannerLines.length] = "Version " + CONFIG.version;
bannerLines[bannerLines.length] = "AkkuVolt Watchdog Multi-Device gestartet";
bannerLines[bannerLines.length] = "Geraete    : " + CONFIG.devices.length + " konfiguriert, " + enabledCount + " aktiv";
 
for (let i = 0; i < CONFIG.devices.length; i++) {
  let cfg = CONFIG.devices[i];
  bannerLines[bannerLines.length] =
    "  - [dev" + i + "] " + cfg.label + " (" + cfg.ip + ")" +
    (cfg.enabled ? "" : "  [DEAKTIVIERT]");
}
 
bannerLines[bannerLines.length] = "Intervall  : " + CONFIG.pollIntervalMs + " ms";
bannerLines[bannerLines.length] = "HTTP-Timeout: " + CONFIG.httpTimeout +
  " s (kein Retry - Fehler zaehlen direkt, Meldung ab " + CONFIG.errorThreshold +
  " Fehlversuchen in Folge)";
bannerLines[bannerLines.length] = "Watchdog   : " + CONFIG.watchdog + " ms";
bannerLines[bannerLines.length] = "Err.Thresh : " + CONFIG.errorThreshold;
bannerLines[bannerLines.length] = "Voll ab    : " + CONFIG.vollSchwelle + "% (Reset bei " + CONFIG.entladeReset + "%)";
bannerLines[bannerLines.length] = "MinVolt-Warn: " + CONFIG.minVoltWarn + "V (Reset bei " + CONFIG.minVoltReset + "V)";
bannerLines[bannerLines.length] = "Temp-Warn  : " + CONFIG.tempWarn + " Grad C (Reset bei " + CONFIG.tempReset + " Grad C)";
bannerLines[bannerLines.length] = "maxMessageLength: " + CONFIG.maxMessageLength + " Zeichen";
bannerLines[bannerLines.length] = "Nachrichten: " + (CONFIG.signal.enabled ? ("aktiviert (" + CONFIG.signal.typ + ")") : "deaktiviert");
bannerLines[bannerLines.length] = "Debug      : " + (CONFIG.debug ? "aktiviert" : "deaktiviert");
bannerLines[bannerLines.length] = "--------------------------------";
 
let bannerIndex = 0;
 
function printBannerLine(onDone) {
  if (bannerIndex >= bannerLines.length) {
    bannerLines = null;
    if (onDone) onDone();
    return;
  }
 
  print(bannerLines[bannerIndex]);
  bannerIndex = bannerIndex + 1;
 
  Timer.set(150, false, function () {
    printBannerLine(onDone);
  });
}
 
function afterBanner() {
  sendSignalMessage("✅ AkkuVolt Watchdog Multi-Device gestartet (" +
    enabledCount + " von " + CONFIG.devices.length + " Geraeten aktiv).");
 
  setupAstroSchedules();
 
  print("Ueberwachung aktiv. Polling alle " + (CONFIG.pollIntervalMs / 1000) + " Sekunden.");
  print("--------------------------------");
 
  update();
  Timer.set(CONFIG.pollIntervalMs, true, update);
}
 
printBannerLine(afterBanner);