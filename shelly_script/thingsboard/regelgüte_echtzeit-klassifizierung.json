// Regelguete-Bins (ThingsBoard Script Calculated Field, TBEL) - Geraet Netz
//
// Argumente (Gross-/Kleinschreibung beachten):
//   gridPower                     Netz       gridPower
//   sf2400home / sf800home        SF2400/800 outputHomePower
//   sf2400charge / sf800charge    SF2400/800 outputPackPower   (Laden)
//
// Klassen (genau eine je Minute):
//   binUnregulated  kein Netzwert oder kein Speicher aktiv
//   binSaturated    ausserhalb Regelbereich:
//                     - Summe outputHomePower beider SF < 15 W
//                       (gesperrt, leer oder laedt nur PV - egal warum)
//                     - oder ein Speicher an seiner Leistungsgrenze
//   binRegulated    bewertbar -> 5 Klassen-Bins + qualityScore
//
// TBEL: keine "a ? b : c" in Map-Literalen.

function leer(v) {
    if (v == null) {
        return true;
    }
    var s = ("" + v).trim();
    return s == "" || s == "null" || s == "unavailable" || s == "unknown";
}

function num(v) {
    if (leer(v)) {
        return 0;
    }
    return parseDouble(("" + v).trim());
}

var TOL = 15;
var GROSS = 50;
var AKTIV = 5;
var GRENZE_2400 = 790;
var GRENZE_800 = 790;

// Zeitstempel-Sperre: nur rechnen, wenn Netz (vom Bridge zuletzt gesendet) neu ist
var tNetz = 0;
if (ctx.args.gridPower != null) {
    tNetz = ctx.args.gridPower.ts;
}
var tMax = 0;
if (ctx.args.sf2400home != null && ctx.args.sf2400home.ts > tMax) {
    tMax = ctx.args.sf2400home.ts;
}
if (ctx.args.sf2400charge != null && ctx.args.sf2400charge.ts > tMax) {
    tMax = ctx.args.sf2400charge.ts;
}
if (ctx.args.sf800home != null && ctx.args.sf800home.ts > tMax) {
    tMax = ctx.args.sf800home.ts;
}
if (ctx.args.sf800charge != null && ctx.args.sf800charge.ts > tMax) {
    tMax = ctx.args.sf800charge.ts;
}
if (tNetz < tMax) {
    return {};
}

var p = num(gridPower);
var a1 = num(sf2400home) + num(sf2400charge);
var a2 = num(sf800home) + num(sf800charge);
var home = num(sf2400home) + num(sf800home);

var aktiv = (a1 > AKTIV || a2 > AKTIV);
var grenze = (num(sf2400home) > GRENZE_2400 || num(sf800home) > GRENZE_800);

// 1) nicht geregelt
if (leer(gridPower) || !aktiv) {
    return {
        "binRegulated": 0,
        "binSaturated": 0,
        "binUnregulated": 1
    };
}

// 2) ausserhalb Regelbereich: kein Speicher liefert ins Haus, oder einer an der Grenze
if (home < TOL || grenze) {
    return {
        "binRegulated": 0,
        "binSaturated": 1,
        "binUnregulated": 0
    };
}

// 3) bewertbar
var inTol = 0;
var smallImp = 0;
var largeImp = 0;
var smallExp = 0;
var largeExp = 0;
if (p >= -TOL && p <= TOL) {
    inTol = 1;
} else if (p > TOL && p <= GROSS) {
    smallImp = 1;
} else if (p > GROSS) {
    largeImp = 1;
} else if (p >= -GROSS) {
    smallExp = 1;
} else {
    largeExp = 1;
}
var q = 0;
if (inTol == 1) {
    q = 100;
}

return {
    "binRegulated": 1,
    "binSaturated": 0,
    "binUnregulated": 0,
    "binInTolerance": inTol,
    "binSmallImport": smallImp,
    "binLargeImport": largeImp,
    "binSmallExport": smallExp,
    "binLargeExport": largeExp,
    "qualityScore": q
};
